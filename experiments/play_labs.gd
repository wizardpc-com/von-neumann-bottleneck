extends "res://experiments/viewport_input.gd"
## Scripted acceptance, explicitly known objectives; not the unknown-answer policy.
func _run() -> void:
	await settle()
	root.size=Vector2i(1440,1000)
	change_scene_to_file("res://experiments/representation/lab.tscn")
	await settle(20); ui=current_scene
	await capture("representation-entry")
	await press(ui.run_button)
	await choose(ui.codec,1); await press(ui.run_button)
	check(ui.completed[0],"Stage one has actual baseline and improvement")
	await capture("representation-scan")
	await press(ui.next_button); await settle()
	for case_index: int in 3:
		await choose(ui.case_choice,case_index)
		await choose(ui.codec,0); await press(ui.run_button)
		await choose(ui.codec,1); await press(ui.run_button)
		await capture("representation-crossover-"+str(case_index))
	check(ui.completed[1],"Stage two observes paired win and losses")
	await press(ui.next_button); await settle()
	await choose(ui.codec,1); await press(ui.run_button)
	await choose(ui.case_choice,1); await press(ui.run_button)
	await capture("representation-point-overfetch")
	await choose(ui.block,0); await press(ui.run_button)
	check(ui.completed[2],"Stage three serves scan and sparse orders")
	await capture("representation-point-improved")
	# Real UI rejection; then ensure the old result can still be inspected.
	await choose(ui.block,2); await choose(ui.cache,1); await press(ui.run_button)
	check(not ui.active_trace.passed,"Oversized cache produces visible rejection")
	await capture("representation-memory-rejected")
	change_scene_to_file("res://experiments/intelligent_workload/lab.tscn")
	await settle(20); ui=current_scene
	await press(ui.run_button); await capture("inference-baseline")
	await choose(ui.codec,3); await choose(ui.block,1); await choose(ui.cache,1)
	await press(ui.run_button); await capture("inference-quality-loss")
	check(ui.active_trace.metrics.max_error>0.02,"Quantized actual outputs fail quality")
	await choose(ui.codec,1); await press(ui.run_button)
	check(ui.active_trace.metrics.max_error<=0.02 and ui.active_trace.metrics.total_cycles<=620,"Observed 8-bit plan meets quality and time")
	var first_output: TreeItem=ui.tree.get_root().get_first_child()
	for i: int in 3: first_output=first_output.get_next()
	await click(ui.tree.global_position+ui.tree.get_item_area_rect(first_output).get_center())
	check(ui.detail.text.contains("absolute_error"),"Trace selection exposes actual per-sample quality")
	await capture("inference-balanced")
	await choose(ui.block,2); await press(ui.run_button)
	check(ui.active_trace.metrics.first_result_cycle>80,"Larger batch fails first response constraint")
	await capture("inference-batch-latency")
	var report := FileAccess.open(evidence_root+"checks.json",FileAccess.WRITE)
	report.store_string(JSON.stringify(observations,"\t"))
	print("PASS: viewport lab acceptance " if failures.is_empty() else "FAIL: viewport lab acceptance ",observations.size())
	quit(0 if failures.is_empty() else 1)
