msgid "demo.task.d1_cpu.title"
msgstr "1-1 Faster CPU, still waiting"

msgid "demo.task.d1_cpu.goal"
msgstr "Upgrade the CPU for the same sum. Compare compute and wait; only CPU may change."

msgid "demo.task.d1_cpu.specs"
msgstr "8-bit system timing model. Program, data, RAM and Bus are fixed.\nComplete with correct output and a controlled CPU comparison.\nWait includes RAM service, bus control and transfer; do not add them again."

msgid "demo.task.d1_cpu.hint1"
msgstr "Compare compute and wait cycles."

msgid "demo.task.d1_cpu.hint2"
msgstr "The CPU changes compute time; memory service conditions stay the same."

msgid "demo.task.d1_cpu.hint3"
msgstr "Use the 1-cycle CPU and inspect the difference from the initial run."

msgid "demo.task.d2_order.title"
msgstr "2-2 Change the reading order"

msgid "demo.task.d2_order.goal"
msgstr "Repeated fetches slow this task. Keep one cache line; edit the program. Read every element once, preserve the sum, and reach ≤110 cycles."

msgid "demo.task.d2_order.specs"
msgstr "A is a 4×4 array stored contiguously by row. Element address = row×4 + column.\nCache holds 4 consecutive integers and fetches/replaces automatically.\nUse two range(4) loops, load, += and final store, with 4 spaces for indentation.\nOutputs, work and timing determine completion."

msgid "demo.task.d2_order.hint1"
msgstr "Follow one fill: which values are used before that line is evicted?"

msgid "demo.task.d2_order.hint2"
msgstr "Addresses 0,1,2,3 share a line; 0,4,8,12 occupy four different lines."

msgid "demo.task.d2_order.hint3"
msgstr "Reference only; does not replace your draft:\nacc = 0\nfor row in range(4):\n    for col in range(4):\n        acc += load(A[row][col])\nstore(OUT[0], acc)"

