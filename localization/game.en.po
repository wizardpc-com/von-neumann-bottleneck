msgid "hardware.tooltip.control"
msgstr "Decodes the 2-bit OPCODE into path selection and write-control signals."
msgid "hardware.tooltip.constant"
msgstr "Continuously outputs a fixed 0 or 1 for control or operation selection."
msgid "hardware.tooltip.tiny_computer"
