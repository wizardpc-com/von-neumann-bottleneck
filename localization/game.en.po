msgid "hardware.tooltip.half_adder"
msgstr "Computes SUM and CARRY for two 1-bit numbers."
msgid "hardware.tooltip.full_adder"
msgstr "Computes A + B + CIN and outputs SUM and COUT."
msgid "hardware.tooltip.mux4"
