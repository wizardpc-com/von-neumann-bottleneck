msgid "hardware.inspector.behavior.and"
msgstr "OUT = A AND B."
msgid "hardware.inspector.behavior.or"
msgstr "OUT = A OR B."
msgid "hardware.inspector.behavior.xor"
msgstr "OUT = A XOR B: 1 exactly when the inputs differ."
msgid "hardware.inspector.behavior.not"
msgstr "OUT = NOT IN."
msgid "hardware.inspector.behavior.nor"
msgstr "OUT = NOT (A OR B)."
msgid "hardware.inspector.behavior.half_adder"
msgstr "SUM = A XOR B; CARRY = A AND B."
msgid "hardware.inspector.behavior.full_adder"
msgstr "SUM is the low bit of A+B+CIN; COUT carries into the next bit."
msgid "hardware.inspector.behavior.mux4"
msgstr "SEL=00/01/10/11 outputs D0/D1/D2/D3 respectively."
msgid "hardware.inspector.behavior.alu1"
msgstr "OP=00/01/10/11 selects AND / OR / ADD / NOT A respectively."
msgid "hardware.inspector.behavior.sr_latch"
msgstr "S,R=00 holds, 10 sets, 01 resets, and 11 is invalid; Q/NQ are complements."
msgid "hardware.inspector.behavior.register1"
msgstr "LOAD=0 holds; LOAD=1 makes Q take D."
msgid "hardware.inspector.behavior.register4"
msgstr "LOAD=0 holds; LOAD=1 makes Q[4] take D[4]."
msgid "hardware.inspector.behavior.decoder1_to_2"
msgstr "ADDR=0 makes SEL0=1; ADDR=1 makes SEL1=1."
msgid "hardware.inspector.behavior.mux2_word"
msgstr "SEL=0 outputs A; SEL=1 outputs B. It selects but does not compute."
msgid "hardware.inspector.behavior.ram2x4"
msgstr "WRITE=1 stores DATA at ADDR; OUT reads the current address."
msgid "hardware.inspector.behavior.control"
msgstr "For OP=00/01/10/11: SOURCE_SEL=0/0/1/0, RESULT_SEL=0/1/0/0, ACC_LOAD=1/1/1/0, MEM_WRITE=0/0/0/1. All control outputs are 1-bit."
msgid "hardware.inspector.behavior.constant"
msgstr "Has no input and always outputs its labeled fixed value."

