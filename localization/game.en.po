msgid "chapter2.notebook.hit.title"
msgstr "CACHE HIT"

msgid "chapter2.notebook.hit.body"
msgstr "The requested line is already nearby, so RAM is not visited."

msgid "chapter2.notebook.hit.diagram"
msgstr "request → Cache → value"

msgid "chapter2.notebook.hit.related"
msgstr "Cache, Locality"

msgid "chapter2.notebook.miss.title"
