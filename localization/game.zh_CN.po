msgid "overlap.error.compute_busy"
msgstr "计算器仍在工作。需要等待 idle 后再启动下一项计算。"

msgid "overlap.error.buffer_or_batch"
msgstr "缓冲名字或批次编号不存在。批次从 0 开始编号。"

msgid "overlap.error.transfer_route"
msgstr "缺少搬运数据线或 free 反馈线。"

msgid "overlap.error.overwrite"
msgstr "这只缓冲尚未空闲，不能覆盖。等待 free，或使用另一只空缓冲。"

msgid "overlap.error.duplicate"
msgstr "同一批数据被重复请求。每批只处理一次。"

msgid "overlap.error.control_route"
msgstr "缺少对应的 ready / free 状态连接。"

msgid "overlap.error.deadlock"
msgstr "等待的状态不会自行出现：没有工作能推动它。检查请求和消费顺序。"

msgid "overlap.error.compute_route"
msgstr "缓冲数据没有连接到计算器。"

msgid "overlap.error.not_ready"
msgstr "请求已经发出，但数据尚未就绪。不要提前 consume。"

msgid "overlap.error.order"
msgstr "批次顺序错误或重复消费。必须按 0、1、2… 输出。"

msgid "overlap.error.cache_route"
msgstr "需要一只正确连线的 Cache，以及有效批次编号。"

msgid "overlap.error.limit"
msgstr "等待超过 4096 周期。检查是否一直等待无法出现的状态。"

msgid "overlap.error.incomplete"
msgstr "没有完整处理全部批次，或首关独立工作量不符合规格。"

