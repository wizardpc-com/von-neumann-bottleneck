msgid "dsl.error.store_outside_loops"
msgstr "第 %d 行：存储操作必须位于两层循环外。"

msgid "dsl.error.stored_variable_initialized"
msgstr "第 %d 行：待存储变量 `%s` 尚未初始化。"

msgid "dsl.explanation.comment"
