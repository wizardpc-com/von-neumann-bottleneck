extends "res://tests/test_performance_player_input.gd"
## Only task access is synthetic; policy choices and observation use viewport input.
const LabState = preload("res://src/lab/lab_state.gd")

func finish() -> void:
	var file := FileAccess.open(evidence_root + "prediction-ui-observations.json", FileAccess.WRITE)
	file.store_string(JSON.stringify(observations, "\t"))
	print("Prediction input checks: %d; failures: %d" % [observations.size(), failures.size()])
	if failures.is_empty(): print("PASS: prediction player input")
	quit(0 if failures.is_empty() else 1)

func tab(index: int) -> void:
	var tabs := ui.find_child("PredictionEvidenceTabs",true,false) as TabContainer
	var bar: TabBar = tabs.get_tab_bar()
	await click(bar.global_position + bar.get_tab_rect(index).get_center())
	check(tabs.current_tab == index,"The visible evidence tab accepts the requested view.")

func metric_check(total: int, traffic: int, waste: int, pollution: int) -> void:
	var m: Dictionary = ui.history.back().trace.metrics
	check(m.total_cycles == total and m.traffic_bytes == traffic,"Measured total and traffic match the independent expected result.")
	check(m.wasted_prediction_bytes == waste and m.pollution_misses == pollution,"Waste and counterfactual misses remain actual model evidence.")
	check(m.total_cycles == m.lookup_cycles+m.compute_cycles+m.blocking_cycles+m.drain_cycles,"The displayed elapsed-time components account for the total.")
	check(ui.result.text.contains(str(total)) and ui.result.text.contains(str(m.baseline_cycles)),"The visible result contains both measured time and its same-stream Off baseline.")
	print("MEASURED: ",JSON.stringify(m))

func _run() -> void:
	root.size = Vector2i(1280,720)
	root.content_scale_size = Vector2i(1280,720)
	root.get_node("GameMode").set_mode(&"test")
	ProjectSettings.set_setting("game/reduced_motion",true)
	var earned: Array = LabState.completed_keys(LabState.tasks())
	check(root.get_node("TaskNavigation").enter("prediction/changed"),"Test access opens the optional investigation without earned prerequisites.")
	await settle(16)
	ui = current_scene
	check(ui.task == 1 and ui.history.is_empty() and ui.policy.rule == "off","A fresh changing-pattern session starts without measurements.")
	await shot("prediction-entry")
	await press(ui.step_button)
	check(ui.revealed == 1 and ui.public_observation().observed_addresses == [0],"Reveal exposes one actual request only.")
	check(ui.history.is_empty() and not ui.result.text.contains("144"),"A prefix does not disclose final costs or create a completed receipt.")
	await press(ui.find_child("Run",true,false))
	metric_check(144,24,0,0)
	check(ui.result.text.begins_with("Same time" if ui.english else "与关闭猜测用时相同"),"The Off result explicitly identifies equal time rather than implying a gain.")
	check(not ui.goal_met(1),"The Off comparison alone cannot satisfy the investigation.")
	var original: String = ui.history[0].trace.canonical_signature()
	await shot("prediction-off-baseline")
	await choose(ui.rule,1)
	check(ui.revealed == 0 and ui.active_trace == null and ui.history.size() == 1,"Editing restarts observation while retaining the finished baseline.")
	for count: int in 4: await press(ui.step_button)
	var public: Dictionary = ui.public_observation()
	check(public.observed_addresses == [0,4,8,12] and public.revealed_decisions.back().guess == 16,"The rule guesses 16 from the four genuinely observed addresses.")
	check(ui.observed.text.contains("Based on observed strides" if ui.english else "按已观察的步长推算"),"The visible decision explains its historical basis in the current language.")
	check(not ui.result.text.contains("168") and ui.history.size() == 1,"The future slowdown remains hidden during the prefix.")
	await shot("prediction-before-pattern-change")
	await press(ui.step_button)
	public = ui.public_observation()
	check(public.observed_addresses == [0,4,8,12,32] and public.revealed_decisions.back().mismatch,"The next reveal exposes the real changed request and the previous mismatch.")
	await shot("prediction-after-pattern-change")
	await press(ui.find_child("Run",true,false))
	metric_check(168,68,20,6)
	check(ui.result.text.begins_with("24 cycles slower" if ui.english else "比关闭猜测慢24周期"),"The failed rule leads with its measured 24-cycle slowdown.")
	check(ui.evidence_progress(1).failure and not ui.goal_met(1),"Measured slowdown advances failure evidence but still requires a non-Off revision.")
	var failure_signature: String = ui.history[1].trace.canonical_signature()
	await shot("prediction-slower-rule")
	await point(ui.result.global_position+Vector2(30,12))
	await shot("prediction-cost-definitions")
	await point(Vector2(20,100))
	await choose(ui.confidence,1)
	await choose(ui.cooldown,1)
	await press(ui.find_child("Run",true,false))
	var revised: Dictionary = ui.history.back().trace.metrics
	check(revised.total_cycles == 138 and ui.result.text.begins_with("6 cycles faster" if ui.english else "比关闭猜测快6周期"),"The revised result shows the actual six-cycle gain without promising zero waste.")
	check(ui.observed.text.contains("Repetition condition not met" if ui.english else "历史未满足重复条件"),"The current rule explains why it emits no final guess.")
	check(ui.observed.get_minimum_size().y <= ui.observed.get_parent().size.y,"The complete observed-history explanation fits its 720p reading area without scrolling.")
	check(ui.policy.rule == "stride" and revised.total_cycles <= revised.baseline_cycles and ui.goal_met(1),"A measured non-Off revision no slower than baseline meets the unchanged goal.")
	check(revised.outputs == ui.history[0].trace.metrics.outputs,"Changing prediction preserves the actual values consumed.")
	print("REVISION: ",JSON.stringify(revised))
	await shot("prediction-safe-revision")
	await tab(2)
	await click(ui.history_list.global_position + ui.history_list.get_item_rect(1).get_center())
	check(ui.selected_run == 1 and ui.policy.confidence == 2 and ui.recorded_source.text.contains("differs" if ui.english else "不同"),"Reviewing a failed record retains the revised draft and labels their difference.")
	await tab(0)
	check(ui.result.text.contains("168") and ui.goal_met(1),"Review shows the old actual result without removing earned session evidence.")
	check(ui.result.text.begins_with("24 cycles slower" if ui.english else "比关闭猜测慢24周期"),"Review recomputes the comparison from the selected record, not the revised draft.")
	await shot("prediction-review-failure")
	check(ui.history[0].trace.canonical_signature() == original and ui.history[1].trace.canonical_signature() == failure_signature,"Policy edits and review do not rewrite either earlier measurement.")
	check(LabState.completed_keys(LabState.tasks()) == earned,"Temporary prediction evidence grants no persistent campaign completion.")
	await finish()
