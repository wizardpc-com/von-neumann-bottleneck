extends "res://tests/test_performance_player_input.gd"
## Test-mode entry; slot edits, format choices and measurements use viewport input.
const Model = preload("res://experiments/service_plan/model.gd")
const LabState = preload("res://src/lab/lab_state.gd")
const Store = preload("res://experiments/service_plan/session_store.gd")

func finish() -> void:
	var file := FileAccess.open(evidence_root + "service-ui-observations.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(observations,"\t"))
	print("Service input checks: %d; failures: %d" % [observations.size(),failures.size()])
	if failures.is_empty(): print("PASS: service player input")
	quit(0 if failures.is_empty() else 1)

func measured(total: int, traffic: int, first: Array, accepted: bool) -> void:
	var m: Dictionary = ui.history.back().metrics
	check(m.error.is_empty() and m.total_cycles == total and m.state_read_bytes+m.state_write_bytes == traffic,"The real run returns the expected elapsed time and state traffic.")
	check(m.first_stream_cycles == first and ui.response_chart.first_responses == first,"The first-response view consumes the four measured response times.")
	check(Model.accepted(m,ui.task) == accepted,"The unchanged current contract determines this measurement's acceptance.")
	print("MEASURED: ",JSON.stringify(m))

func _run() -> void:
	root.size = Vector2i(1280,720)
	root.content_scale_size = Vector2i(1280,720)
	root.get_node("GameMode").set_mode(&"test")
	ProjectSettings.set_setting("playtest/offline_tester",true)
	ProjectSettings.set_setting("game/reduced_motion",true)
	var entered: bool = root.get_node("TaskNavigation").enter("service/prompt_response")
	check(entered,"Offline tester access opens timely service without earning prior tasks.")
	if not entered:
		await finish()
		return
	await settle(16)
	ui = current_scene
	check(ui.task == 1 and ui.persistent_session and ui.history.is_empty() and ui.support_plans.is_empty(),"The isolated profile starts with an unmeasured service draft.")
	for id: String in ["Quit","ServiceCommissions","RestoreSupport","ServiceNext","SaveSession","FormatGuide"]:
		var control: Control = ui.find_child(id,true,false)
		check(control != null and root.get_visible_rect().encloses(control.get_global_rect()),"The entire control fits the 720p viewport: "+id)
	await shot("service-entry")
	await press(ui.run_button)
	measured(2204,3168,[89,180,271,362],false)
	check(ui.status.text.contains("362") and ui.status.text.contains("320") and ui.status.text.contains("42"),"The failed first-response feedback states actual time, limit and excess.")
	check(ui.status.text.contains("(D)"),"The latest-response failure identifies the actually delayed stream D.")
	var first_record: String = JSON.stringify(ui.history[0])
	await shot("service-late-first-response")
	await edit_number(ui.slots,4)
	check(ui.plan.slots == 4 and ui.history.size() == 1 and ui.history[0].metrics.plan.slots == 1,"Changing capacity changes the draft but preserves the one-slot measurement.")
	await press(ui.run_button)
	measured(1324,528,[89,158,227,296],true)
	check(ui.support_plans.has(1) and not ui.next_button.disabled,"A measured exact and timely plan unlocks continuation.")
	var support: Dictionary = ui.support_plans[1].duplicate(true)
	await shot("service-timely-exact")
	await press(ui.format_buttons[0])
	await press(ui.format_buttons[0])
	check(ui.plan.representations[0] == "raw8","Two visible format changes select RAW8 for stream A only.")
	await shot("service-raw8-explanation")
	await press(ui.run_button)
	var approximate: Dictionary = ui.history.back().metrics
	check(approximate.error.is_empty() and approximate.max_error > 1e-9 and approximate.max_state_error > 1e-9 and not Model.accepted(approximate,1),"Quantized computation runs but fails the original exact-quality contract.")
	check(ui.status.text.contains("Score error" if ui.english else "分数误差") and ui.status.text.contains("A") and ui.status.text.contains("1e-9"),"Visible quality feedback names the offending stream and exact tolerance.")
	check(ui.support_plans[1] == support and not ui.next_button.disabled,"An unsuccessful experiment does not erase the previously earned successful plan.")
	print("APPROXIMATE: ",JSON.stringify(approximate))
	await shot("service-precision-unmet")
	await press(ui.find_child("RestoreSupport",true,false))
	check(ui.plan == support and ui.history.back().metrics.plan.representations[0] == "raw8","Restoring earned support changes the draft, not the failed recorded measurement.")
	await press(ui.next_button)
	check(ui.task == 2 and not ui.support_plans.has(2),"Continue opens the next contract without completing it.")
	await press(ui.run_button)
	measured(1324,528,[89,158,227,296],false)
	check(ui.status.text.contains("528") and ui.status.text.contains("320") and ui.status.text.contains("208"),"The stricter contract explains why the previously timely plan now exceeds state traffic.")
	await shot("service-next-contract-traffic")
	await press(ui.format_buttons[0])
	await press(ui.format_buttons[1])
	check(ui.plan.representations == ["rle64","rle64","raw64","raw64"],"The player changes each selected stream's representation independently.")
	await press(ui.run_button)
	measured(1280,316,[78,136,205,274],true)
	check(ui.history.back().metrics.max_error == 0 and ui.history.back().metrics.max_state_error == 0,"The measured mixed-format plan preserves exact scores and final states.")
	check(ui.support_plans.has(1) and ui.support_plans.has(2) and not ui.has_service_closure(),"Only the two actually earned contracts are retained; the unplayed first contract prevents chapter closure.")
	await shot("service-mixed-plan-met")
	await press(ui.find_child("SaveSession",true,false))
	check(FileAccess.file_exists(Store.PATH),"Save writes the real exploration into its existing isolated session file.")
	check(LabState.completed_keys(LabState.tasks()) == ["service/prompt_response","service/one_plan"],"Only actually measured task supports become persistent journey evidence.")
	check(JSON.stringify(ui.history[0]) == first_record,"Later edits, contracts and saving preserve the first measured record.")
	await shot("service-saved")
	await finish()
